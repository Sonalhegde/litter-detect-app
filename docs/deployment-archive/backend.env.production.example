# Production backend (Render Docker) — set these in the Render dashboard or render.yaml
# Replace Vercel origin(s) with your actual frontend URL(s). No trailing slashes.

CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
YOLO26S_MODEL_PATH=/app/models/yolo26s.onnx
YOLO26S_MODEL_SHA256=b72f5cdef5451af4abb2d0051d9c95d0092e8a85f3cdf2fdb3d7644d6a56d6d7

# Render Free–tier constraints (512 MB RAM, shared CPU)
INFERENCE_IMAGE_SIZE=320
MAX_UPLOAD_MB=8
MAX_IMAGE_WIDTH=3000
MAX_IMAGE_HEIGHT=3000
MAX_IMAGE_PIXELS=6000000
INFERENCE_CONCURRENCY=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=true
