# Comma-separated list of browser origins allowed by CORS.
# Must include the exact URL your frontend is served from (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://sentinel-sonalhegde.vercel.app

# Path to the deployed ONNX artifact (relative to the backend/ directory or absolute).
YOLO26S_MODEL_PATH=models/yolo26s.onnx

# SHA-256 fingerprint of the ONNX artifact. Must match the file at YOLO26S_MODEL_PATH.
YOLO26S_MODEL_SHA256=969bbf4733dd1486478e55cbb511569dc0bb7a75cf889597274b02b336b3ceb2

# Input resolution used when the model was exported. The backend reads the
# declared shape from the ONNX graph at startup, so this only affects the
# reported setting — it does not override the model's actual input size.
INFERENCE_IMAGE_SIZE=320

# Confidence threshold (0–1). Detections below this are discarded.
INFERENCE_CONFIDENCE_THRESHOLD=0.25

# IoU threshold (0–1) used for non-maximum suppression.
INFERENCE_IOU_THRESHOLD=0.45

# Maximum upload size in MB.
MAX_UPLOAD_MB=4

# Maximum decoded image dimensions in pixels (width and height independently).
MAX_IMAGE_WIDTH=3000
MAX_IMAGE_HEIGHT=3000

# Maximum total decoded pixel count.
MAX_IMAGE_PIXELS=6000000

# Maximum concurrent inference requests per instance.
INFERENCE_CONCURRENCY=1

# Rate limit: maximum requests per window per client IP.
RATE_LIMIT_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=60
