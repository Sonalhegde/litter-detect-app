# Comma-separated list of browser origins allowed by CORS.
# Must include the exact URL your frontend is served from (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Path to the deployed ONNX artifact (relative to the backend/ directory or absolute).
YOLO26S_MODEL_PATH=models/yolo26s.onnx

# SHA-256 fingerprint of the ONNX artifact. Must match the file at YOLO26S_MODEL_PATH.
YOLO26S_MODEL_SHA256=b72f5cdef5451af4abb2d0051d9c95d0092e8a85f3cdf2fdb3d7644d6a56d6d7

# Target export side length for YOLO ONNX (runtime uses the graph's fixed input until re-exported).
INFERENCE_IMAGE_SIZE=1280

# Confidence threshold (0–1). Detections below this are discarded.
INFERENCE_CONFIDENCE_THRESHOLD=0.25

# IoU threshold (0–1) used for non-maximum suppression.
INFERENCE_IOU_THRESHOLD=0.45

# Maximum upload size in MB (local default allows large camera JPEGs).
MAX_UPLOAD_MB=50

# Maximum decoded image dimensions in pixels (width and height independently).
MAX_IMAGE_WIDTH=12000
MAX_IMAGE_HEIGHT=12000

# Maximum total decoded pixel count.
MAX_IMAGE_PIXELS=120000000

# Concurrent inference jobs (omit to use logical CPU count).
# INFERENCE_CONCURRENCY=8

# ONNX Runtime thread pools per session (optional; derived from CPU count when unset).
# ONNX_INTRA_OP_THREADS=2
# ONNX_INTER_OP_THREADS=1

# Public-demo rate limiting (disabled by default for local-only use).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Trust X-Forwarded-For only when explicitly enabled (e.g. behind a reverse proxy).
# TRUST_PROXY_HEADERS=false
